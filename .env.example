# Aplicação
APP_NAME="Boss Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública da API. Em produção, o subdomínio da API.
APP_URL=http://localhost:8000
# Porta do host mapeada para o container da API pelo Sail.
APP_PORT=8000
# Fuso de armazenamento. O fuso de exibição vem das settings da loja.
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Primeiro usuário do painel, criado pelo seeder (db:seed). Vazio: o seeder não cria ninguém.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (PostgreSQL no container "pgsql" do Sail)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=boss_store
DB_USERNAME=sail
DB_PASSWORD=password
# Porta do host mapeada para o PostgreSQL do Sail.
FORWARD_DB_PORT=5432

# Redis (container "redis" do Sail): cache, filas e sessão
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Porta do host mapeada para o Redis do Sail.
FORWARD_REDIS_PORT=6379

CACHE_STORE=redis
# CACHE_PREFIX=
# Cache das settings da loja (spatie/laravel-settings) no CACHE_STORE.
SETTINGS_CACHE_ENABLED=false
QUEUE_CONNECTION=redis

# Sessão (usada pela autenticação do painel via Sanctum)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Domínio do cookie de sessão. Em produção, o domínio comum da API e do painel (ex.: .loja.com.br).
SESSION_DOMAIN=null
# Em produção (HTTPS): SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Autenticação do painel (Sanctum SPA por cookie)
# Hosts (sem esquema) que recebem cookie de sessão, separados por vírgula.
SANCTUM_STATEFUL_DOMAINS=localhost:9000
# Origens (com esquema e porta) autorizadas no CORS, separadas por vírgula: painel e catálogo.
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:3000
AUTH_LOGIN_MAX_ATTEMPTS_PER_MINUTE=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# E-mail (em desenvolvimento, só grava no log)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sail
# Modo do Xdebug no container (off, debug, develop, coverage...).
SAIL_XDEBUG_MODE=off
